#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define MEDIA 3

// hold-preferred is &mt's own default, restored here deliberately after a
// detour through balanced. balanced only decides on the OTHER key's release,
// and a hold-tap captures every later keypress while undecided. Holding Ctrl
// and Space together therefore never produced an "other key up", so Ctrl sat
// undecided until its own 200 ms timer with the Space press still queued
// behind it. hold-preferred decides the instant Space goes down.
//
// Keep every &mt directly in the keymap. A tap dance that wraps &mt creates
// the hold-tap only after the dance resolves, after the interrupting key has
// already passed the hold-tap listener. That delayed modifiers and could drop
// a second hold-tap entirely.
&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
};

// hold-preferred so the layer engages the moment a second key goes down.
// The default, tap-preferred, only resolves on timeout, which meant every
// Lower/Raise access cost a full 200 ms dwell before the layer was live.
&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
};

/ {
    macros {
        lower_base_peek: lower_base_peek {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_tap &tog LOWER>
                , <&macro_pause_for_release>
                , <&macro_tap &tog LOWER>
                ;
        };

        lower_bslash_tap: lower_bslash_tap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BSLH>;
        };

    };

    combos {
        compatible = "zmk,combos";

        // Combos match key POSITIONS, not letters, so an unscoped combo also
        // fires on other layers. Everything benign is pinned to BASE: <0 1>
        // is 1+2 on Lower and BT0+BT1 on Raise; <12 13> is 7+8 on Lower.
        // L+J has no combo; Backspace is Lower+H/E/G or Navigation/Media+O.
        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
            layers = <BASE>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            layers = <BASE>;
        };

        raise_once {
            bindings = <&sl RAISE>;
            key-positions = <38 39>;
            layers = <BASE>;
        };

        // Both destructive combos used to sit on the editing keys: <0 5> was
        // Left-arrow + Backspace, and <4 5> was the same L+J chord trained as
        // Backspace elsewhere, one slip from dropping into UF2 with no HID.
        // Moved onto the bottom row, where they are deliberate finger presses
        // and never occur while navigating or deleting.
        clear_bluetooth {          // V + W on Raise; NOT the BT selector keys
            bindings = <&bt BT_CLR>;
            key-positions = <38 39>;
            layers = <RAISE>;
            timeout-ms = <50>;
        };

        bootloader_combo {         // X + G on Raise, bottom row
            bindings = <&bootloader>;
            key-positions = <36 37>;
            layers = <RAISE>;
            timeout-ms = <150>;
        };
    };

    behaviors {
        // xlayers/klayers are gone. Wrapping &lt in a tap-dance meant the dance
        // had to resolve first, and tap-dance resolves EAGERLY on any other key
        // press without buffering it. So pressing a second key inside 175 ms
        // leaked the base letter through before the layer was live, and waiting
        // it out cost 175 ms + the hold-tap's own 200 ms. X and K are now plain
        // &lt; locking moved to Z, which is a standalone press and cannot be
        // torn down by the &lt release.

        // The user operates Y with the pinky, leaving the index finger free
        // for O/Backspace and H/J/K/L available for navigation. Reuse Media
        // rather than adding a fifth layer. Tap-preferred still requires the
        // full 200 ms hold, protecting quick Y rolls from navigation/media.
        ymedia: ymedia {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lower_bslash_base: lower_bslash_base {
            compatible = "zmk,behavior-hold-tap";
            label = "LOWER_BSLASH_BASE";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&lower_base_peek>, <&lower_bslash_tap>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // Left half: all letters plus thumb tap/hold behaviors. The right half is disconnected.
            // | Q | P | F | M | L | J |
            // | B | Y: tap Y / hold NAVIGATION+MEDIA | U | R | S | O |
            // | C | D | T | H | E | A |
            // | X: tap X / hold LOWER | G | V | W | N | I | K: tap K / hold RAISE |
            //     | Z | SLASH/ALT | ESC/CTRL | COMMA/CMD | SPACE/SHIFT |
            // To lock a layer: hold X (or K), then tap Z. To leave it: tap Z.

            bindings = <
&kp Q  &kp P  &kp F     &kp M             &kp L            &kp J                                       &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &none
&kp B  &ymedia MEDIA Y  &kp U     &kp R                 &kp S            &kp O                                       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp C  &kp D  &kp T     &kp H                 &kp E            &kp A                                       &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&lt LOWER X  &kp G  &kp V     &kp W                 &kp N            &kp I          &lt RAISE K          &none      &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
              &kp Z     &mt LEFT_ALT SLASH  &mt LEFT_CONTROL ESC  &mt LEFT_COMMAND COMMA  &mt LEFT_SHIFT SPACE    &kp SPACE  &mo RAISE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // Left half:
            // | 1 | 2 | 3 | 4 | 5 | 6 |
            // | 7 | 8 | 9 | 0 | - | = |
            // | ' | UNUSED | ; | BACKSPACE | BACKSPACE | CTRL+A |
            // Hold X to use temporarily, or hold X then tap Z to lock. Tap Z to leave.
            // Hold X then tap H, E, or G for Backspace; Y+O is still available.
            // This is a Lower binding, not a combo. Raise X+G stays bootloader.
            // Tab remains Base B+Y; add the Shift thumb for Shift+Tab.
            // | BACKSLASH: tap \\ / hold BASE | BACKSPACE | BACKSLASH | UNUSED | [ | ] | ` |
            // V makes backslash/pipe reachable while X is held. Slash is on
            // the Option thumb; period is on the Command thumb.
            // N/I keep [ and ] side by side; Shift gives { and }.
            // E is Backspace. Comma stays on Base's Command thumb.
            // A sends Ctrl+A only: in Ghostty, keep X held and tap Q/P/F for
            // leader 1/2/3, or release X before tapping a Base H/J/K/L command.
            //     | Z: lock / unlock | SLASH/ALT | ESC/CTRL | PERIOD/CMD | ENTER/SHIFT |

            bindings = <
&kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp NUMBER_4   &kp N5            &kp NUMBER_6                                 &kp F6     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11
&kp N7        &kp N8         &kp N9        &kp N0         &kp MINUS         &kp EQUAL                                    &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp F12
&kp SQT       &none          &kp SEMI      &kp BACKSPACE  &kp BACKSPACE     &kp LC(A)                                    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&lower_bslash_base 0 0  &kp BACKSPACE  &kp BSLH  &none        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE    &trans  &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH  &trans
                             &tog LOWER    &mt LEFT_ALT SLASH  &trans       &mt LEFT_COMMAND DOT  &mt LEFT_SHIFT ENTER  &trans  &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";

            // Hold K to use temporarily, or hold K then tap Z to lock. Tap Z to leave.
            // K itself taps ESC here. Z is the single reliable layer exit.
            // V+W on Base activates Raise for one keypress, normally to launch an app.
            // Q/P (Lower's 1/2 positions) select existing BT profiles 0/1.
            // Recovery combos stay on the bottom row: V+W clears the selected
            // Bluetooth profile; X+G enters the bootloader. Do not move clear
            // onto the BT selectors. Navigation and Backspace now live on Y.
            // | BT0      | BT1    | FINDER   | UNUSED | UNUSED   | UNUSED |
            // Y emits F18 for browser transcript; Shift+Y requests the full brief.
            // | BROWSER  | BRIEF  | UNUSED   | UNUSED | SETTINGS | UNUSED |
            // | CHAT     | UNUSED | TERMINAL | UNUSED | UNUSED   | UNUSED |
            // | UNUSED   | UNUSED | UNUSED   | UNUSED | NOTES    | DISPLAY ON | ESC |
            //     | Z: lock / unlock | SLASH/ALT | ESC/CTRL | COMMA/CMD | SPACE/SHIFT |

            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1       &kp F19        &none              &none              &none                                        &trans     &trans    &trans    &trans     &trans   &trans
&kp F13       &kp F18            &none          &none              &kp F17            &none                                        &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&kp F16       &none              &kp F14        &none              &none              &none                                        &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&none         &none              &none          &none              &kp F15            &ext_power EP_ON   &kp ESC           &trans  &trans     &trans    &trans    &trans     &trans   &trans
                                 &tog RAISE    &mt LEFT_ALT SLASH  &mt LEFT_CONTROL ESC  &mt LEFT_COMMAND COMMA  &mt LEFT_SHIFT SPACE    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media_layer {
            display-name = "nav/media";

            // Hold Y for 200 ms: H/J/K/L are Left/Down/Up/Right; O is Backspace.
            // P/F/M are Volume Down/Volume Up/Mute. No forward Delete.
            // The deliberate dwell protects quick Y rolls from commands.
            //
            // Reached only while Y is physically held. There is no &tog here
            // and no exit key, so it is not a layer you can be stranded in.
            // | UNUSED | VOLUME DOWN | VOLUME UP | MUTE | RIGHT | DOWN |
            // | UNUSED | HELD Y | UNUSED | UNUSED | UNUSED | BACKSPACE |
            // | UNUSED | UNUSED | UNUSED | LEFT | UNUSED | UNUSED |
            // | UNUSED | UNUSED | UNUSED | UNUSED | UNUSED | UNUSED | UP |
            // The four modifier thumbs use the Base tap/hold behaviors. Z is
            // unused here: release Y to return to the underlying layer.

            bindings = <
&none  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &kp RIGHT  &kp DOWN                              &trans  &trans  &trans  &trans  &trans  &trans
&none  &none         &none         &none       &none      &kp BACKSPACE                         &trans  &trans  &trans  &trans  &trans  &trans
&none  &none         &none         &kp LEFT    &none      &none                                 &trans  &trans  &trans  &trans  &trans  &trans
&none  &none         &none         &none       &none      &none         &kp UP                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
              &none    &mt LEFT_ALT SLASH  &mt LEFT_CONTROL ESC  &mt LEFT_COMMAND COMMA  &mt LEFT_SHIFT SPACE  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
